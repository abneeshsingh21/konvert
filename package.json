{
  "name": "konvert",
  "displayName": "Konvert — English to Code Compiler",
  "version": "0.2.3",
  "description": "Deterministic English-to-Code compiler — Write English, Ship Code. 0% Hallucinations, <2ms Latency, 100% Offline.",
  "icon": "icon.png",
  "type": "module",
  "publisher": "epl-lang",
  "author": "epl-lang",
  "main": "./dist/extension.cjs",
  "types": "./dist/compiler/index.d.ts",
  "bin": {
    "konvert": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abneeshsingh21/konvert"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:konvert",
    "onCommand:konvert.quickHUD",
    "onCommand:konvert.openLivePreview",
    "onCommand:konvert.openReactiveTwin",
    "onCommand:konvert.ejectEnglish",
    "onCommand:konvert.rebuildProject",
    "onCommand:konvert.convertEnglishToCode",
    "onCommand:konvert.downloadModel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "konvert",
        "aliases": ["Konvert", "knv"],
        "extensions": [".knv"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "konvert",
        "scopeName": "source.knv",
        "path": "./syntaxes/knv.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "konvert.openReactiveTwin",
        "title": "Konvert: Open Live Reactive Twin (Continuous Split View)",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "konvert.quickHUD",
        "title": "Konvert: Quick English-to-Code HUD (Realtime)",
        "icon": "$(zap)"
      },
      {
        "command": "konvert.openLivePreview",
        "title": "Konvert: Open Live Compiler Preview",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "konvert.ejectEnglish",
        "title": "Konvert: Eject English (Keep Pure Target Code)",
        "icon": "$(trash)"
      },
      {
        "command": "konvert.rebuildProject",
        "title": "Konvert: Rebuild Entire Multi-File Project",
        "icon": "$(refresh)"
      },
      {
        "command": "konvert.convertEnglishToCode",
        "title": "Konvert: Convert English to Code (Prompt)",
        "icon": "$(edit)"
      },
      {
        "command": "konvert.downloadModel",
        "title": "Konvert: Download AI Language Engine (Instant)",
        "icon": "$(cloud-download)"
      }
    ],
    "keybindings": [
      {
        "command": "konvert.openReactiveTwin",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "konvert.quickHUD",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "konvert.quickHUD",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "konvert.openLivePreview",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      }
    ]
  },
  "scripts": {
    "build": "tsc && esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest bench",
    "lint": "eslint src/"
  },
  "keywords": [
    "konvert",
    "compiler",
    "english-to-code",
    "cnl",
    "code-generation",
    "deterministic",
    "offline"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "chevrotain": "^11.2.0"
  }
}
